# SafeTube Environment Configuration Example
# Copy this file to .env or .env.local for local development,
# or set these environment variables in your Vercel Dashboard.

# 1. Google Sheets Configuration
# The ID of your Google Sheet (from https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
VITE_GOOGLE_SHEETS_ID=your_google_sheet_id_here

# The range containing YouTube URLs (Column A)
VITE_GOOGLE_SHEETS_RANGE=Videos!A2:A

# Optional: Google Sheets API v4 Key (not required if Sheet is set to "Anyone with the link can view")
VITE_GOOGLE_SHEETS_API_KEY=

# 2. YouTube Data API v3 Configuration
# Optional: YouTube Data API v3 key for retrieving high-resolution snippets, descriptions, and durations
# If blank, SafeTube automatically falls back to YouTube's public oEmbed service + HQ thumbnails
VITE_YOUTUBE_API_KEY=

# 3. Serverless API Environment Variables (for Vercel deployment)
# In production, these are read by api/videos.ts to securely keep keys off the client
GOOGLE_SHEETS_ID=your_google_sheet_id_here
GOOGLE_SHEETS_RANGE=Videos!A2:A
GOOGLE_SHEETS_API_KEY=
YOUTUBE_API_KEY=
